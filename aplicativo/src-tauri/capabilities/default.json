{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions limited to event listen/unlisten and the exact library/account commands required by the current frontend flows",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-show",
    "dialog:allow-open",
    "core:webview:allow-create-webview-window",
    "allow-list-library-entries",
    "allow-record-boot-marker",
    "allow-add-manual-game",
    "allow-update-manual-game",
    "allow-sync-local-games",
    "allow-sync-steam-games",
    "allow-sync-steam-account-games",
    "allow-get-steam-enrichment-retry-summary",
    "allow-get-library-settings",
    "allow-save-library-settings",
    "allow-get-steam-account-config",
    "allow-get-steam-library-roots",
    "allow-get-xbox-account-config",
    "allow-get-xbox-live-client-config",
    "allow-get-xbox-live-client-secret-state",
    "allow-get-xbox-library-roots",
    "allow-get-xbox-live-auth-state",
    "allow-start-steam-openid-login",
    "allow-start-xbox-live-login",
    "allow-save-steam-account-config",
    "allow-save-steam-library-roots",
    "allow-save-xbox-account-config",
    "allow-save-xbox-live-client-config",
    "allow-save-xbox-live-client-secret",
    "allow-save-xbox-library-roots",
    "allow-save-steam-web-api-key",
    "allow-get-steam-web-api-key-state",
    "allow-disconnect-steam-web-api-key",
    "allow-set-library-entry-archived",
    "allow-set-library-entry-favorite",
    "allow-launch-library-entry",
    "allow-sync-xbox-games",
    "allow-sync-xbox-achievement-games"
  ]
}
