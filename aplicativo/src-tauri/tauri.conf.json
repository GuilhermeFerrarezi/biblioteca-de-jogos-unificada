{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Biblioteca de Jogos Unificada",
  "version": "0.1.0",
  "identifier": "com.bibliotecajogos.unificada",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Biblioteca de Jogos",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": {
        "default-src": "'self' asset:",
        "script-src": ["'self'", "asset:"],
        "style-src": ["'self'", "'unsafe-inline'", "asset:"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "blob:", "data:", "https://cdn.akamai.steamstatic.com", "https://shared.akamai.steamstatic.com", "https://steamcdn-a.akamaihd.net"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost"],
        "font-src": ["'self'"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "frame-ancestors": ["'none'"],
        "form-action": ["'self'"]
      },
      "devCsp": {
        "default-src": "'self' asset:",
        "script-src": ["'self'", "'unsafe-inline'", "'unsafe-eval'", "asset:"],
        "style-src": ["'self'", "'unsafe-inline'", "asset:"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "blob:", "data:", "https://cdn.akamai.steamstatic.com", "https://shared.akamai.steamstatic.com", "https://steamcdn-a.akamaihd.net"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "http://localhost:5173", "ws://localhost:5173"],
        "font-src": ["'self'"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "frame-ancestors": ["'none'"],
        "form-action": ["'self'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
